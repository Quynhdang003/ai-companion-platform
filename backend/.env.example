APP_ENV=
DATABASE_URL=
TEST_DATABASE_URL=
CLERK_ISSUER=
# JSON lists
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
CLERK_WEBHOOK_SECRET=
CORS_ORIGINS=["http://localhost:3000"]
DOGRAH_API_KEY=
SESSION_TOKEN_TTL_MINUTES=120
# Dograh API origin (its BACKEND_API_ENDPOINT); transcripts are downloaded only from here.
DOGRAH_BASE_URL=http://localhost:8010
# Google AI Studio key for memory extraction, scam analysis and embeddings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LLM_TIMEOUT_SECONDS=30
# Scam classification model: its own free-tier quota, separate from GEMINI_MODEL.
GEMINI_SCAM_MODEL=gemini-3.5-flash-lite
# Budget of one in-call scam check; past it, the layer-1 rules answer alone.
SCAM_CHECK_TIMEOUT_SECONDS=6
# Telegram bot from @BotFather for urgent family scam alerts; unset token turns them off.
TELEGRAM_BOT_TOKEN=
# Bot username without "@", used in the t.me connect link.
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_TTL_MINUTES=15
TELEGRAM_POLL_INTERVAL_SECONDS=3
ALERT_JOB_INTERVAL_SECONDS=5
