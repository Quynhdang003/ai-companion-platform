APP_ENV=
# SQLite file with quotes and bookings; delete it to start empty.
DATABASE_URL=sqlite+aiosqlite:///./ride_sim.db
# Same seed and count -> the same drivers.
SEED=2026
DRIVER_COUNT=60
# Simulated seconds per real second: 30 makes a 20-minute trip end after 40 s.
TIME_SCALE=1
# How long a quote can be booked, in real seconds.
QUOTE_TTL_SECONDS=300
