APP_ENV=
# SQLite file with quotes and bookings; delete it to start empty.
DATABASE_URL=sqlite+aiosqlite:///./ride_sim.db
# Same seed and count -> the same drivers.
SEED=2026
DRIVER_COUNT=60
# Simulated seconds per real second: 30 makes a 20-minute trip end after 40 s.
# Also changeable while running: PATCH /sim/config.
TIME_SCALE=1
# How long a quote can be booked, in real seconds.
QUOTE_TTL_SECONDS=300

# Map servers. Empty: straight-line estimates and the built-in Hanoi places only (no network).
OSRM_BASE_URL=https://router.project-osrm.org
ROUTER_TIMEOUT_SECONDS=2
PHOTON_BASE_URL=https://photon.komoot.io
GEOCODER_TIMEOUT_SECONDS=6

# Fault active from the start: no_driver, driver_cancels, timeout or price_surge; empty = none.
# Also changeable while running: PATCH /sim/config.
FAULT=
# Under `timeout`, requests hang this long (seconds), then answer 504.
FAULT_TIMEOUT_SECONDS=15
# Under `price_surge`, new quotes cost this many times more.
SURGE_MULTIPLIER=1.8
