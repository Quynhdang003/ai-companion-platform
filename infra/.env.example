POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Dograh (self-host). Required: generate with `python -c "import secrets; print(secrets.token_hex(32))"`.
DOGRAH_JWT_SECRET=
# Optional; defaults are fine for local dev, set strong values on a VPS.
# DOGRAH_POSTGRES_PASSWORD is baked into the Dograh DB volume on first start.
DOGRAH_POSTGRES_PASSWORD=
DOGRAH_REDIS_PASSWORD=
DOGRAH_MINIO_ROOT_USER=
DOGRAH_MINIO_ROOT_PASSWORD=
# Host ports (defaults 3010 / 8010; the backend uses 8000).
DOGRAH_UI_PORT=
DOGRAH_API_PORT=
# false after creating the first Dograh account.
DOGRAH_ENABLE_SIGNUP=
DOGRAH_ENABLE_TELEMETRY=false
# VPS deploy only (public origin for Dograh's webhook/embed links).
DOGRAH_PUBLIC_BASE_URL=
DOGRAH_PUBLIC_HOST=
DOGRAH_BACKEND_API_ENDPOINT=
DOGRAH_MINIO_PUBLIC_ENDPOINT=
